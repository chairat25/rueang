# ── Supabase (public — ปลอดภัยที่จะส่งไป client) ─────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── Server only — ห้ามขึ้นต้นด้วย NEXT_PUBLIC_ และห้าม import นอก lib/supabase/admin.ts
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Link preview ────────────────────────────────────────────────────────────
LINK_PREVIEW_TIMEOUT_MS=5000
LINK_PREVIEW_MAX_BYTES=524288
LINK_PREVIEW_MAX_REDIRECTS=3
LINK_PREVIEW_RATE_LIMIT_PER_MIN=30

# ── Upload ──────────────────────────────────────────────────────────────────
MAX_UPLOAD_BYTES=26214400
